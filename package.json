{
  "name": "shadow-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "English shadowing coach PWA",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
